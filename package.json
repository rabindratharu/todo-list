{
	"name": "aquila-features",
	"version": "1.0.1",
	"description": "Aquila features plugin packages",
	"main": "main.js",
	"scripts": {
		"composer-start": "rm -rf vendor/ composer.lock && composer clear-cache && composer install",
		"composer-build": "rm -rf vendor/ composer.lock && composer clear-cache && composer install --no-dev --prefer-dist --optimize-autoloader",
		"build": "npm run clean && wp-scripts build --mode=production",
		"start": "npm run clean && wp-scripts start --mode=development",
		"clean": "rm -rf assets/build/*",
		"lint:js": "wp-scripts lint-js assets/src/js",
		"lint:js:fix": "wp-scripts lint-js assets/src/js --fix",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"lint:css": "wp-scripts lint-style 'assets/src/sass/**/*.scss' 'assets/src/css/**/*.css'",
		"lint:css:fix": "wp-scripts lint-style 'assets/src/sass/**/*.scss' 'assets/src/css/**/*.css' --fix",
		"lint:pkg": "wp-scripts lint-pkg-json",
		"format:js": "wp-scripts format assets/src/js",
		"check-engines": "wp-scripts check-engines",
		"packages-update": "wp-scripts packages-update",
		"precommit": "npm run lint:php && npm run lint:css:fix && npm run lint:js:fix && npm run build",
		"cypress:open": "node_modules/.bin/cypress open",
		"translate": "wp i18n make-pot ./ languages/aquila-features.pot --exclude=builds/,node_modules/,cypress/,vendor --ignore-domain --allow-root",
		"release": "npm run build && npm run translate && grunt preBuildClean && grunt build"
	},
	"keywords": [
		"wordpress",
		"plugin",
		"aquila"
	],
	"author": "Imran Sayed",
	"license": "MIT",
	"private": true,
	"devDependencies": {
		"@svgr/cli": "^8.1.0",
		"@wordpress/stylelint-config": "^23.25.0",
		"autoprefixer": "^10.4.21",
		"copy-webpack-plugin": "^13.0.1",
		"cross-env": "^7.0.3",
		"css-loader": "^7.1.2",
		"cypress": "^13.6.0",
		"grunt": "^1.5.3",
		"grunt-checktextdomain": "^1.0.1",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"load-grunt-tasks": "^5.1.0",
		"mini-css-extract-plugin": "^2.9.4",
		"postcss": "^8.4.32",
		"postcss-cli": "^11.0.0",
		"postcss-scss": "^4.0.9",
		"rtlcss-webpack-plugin": "^4.0.7",
		"sass": "^1.93.2",
		"sass-loader": "^16.0.5",
		"terser-webpack-plugin": "^5.3.14",
		"webpack": "^5.89.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"dependencies": {
		"@wordpress/base-styles": "^6.8.0",
		"@wordpress/block-editor": "^15.5.0",
		"@wordpress/blocks": "^15.5.0",
		"@wordpress/components": "^30.5.0",
		"@wordpress/compose": "^7.32.0",
		"@wordpress/data": "^10.32.0",
		"@wordpress/element": "^6.32.0",
		"@wordpress/eslint-plugin": "^22.19.0",
		"@wordpress/hooks": "^4.32.0",
		"@wordpress/i18n": "^6.5.0",
		"@wordpress/icons": "^10.32.0",
		"@wordpress/scripts": "^30.26.0",
		"@wordpress/server-side-render": "^6.8.0",
		"css-minimizer-webpack-plugin": "^7.0.2"
	},
	"browserslist": {
		"production": [
			"> 0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}